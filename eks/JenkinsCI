pipeline {
    agent any
    tools {
        maven 'maven3'
    }
    stages {
        stage('cleanWS'){
            steps{
                cleanWs()
            }
        }
        stage('code') {
            steps {
                git branch: 'main', url: 'https://github.com/Kajjayamsriram/Docker-2-tier-app.git'
            }
        }
        stage('Build') {
            steps{
                sh "mvn package"
            }
        }
        stage('CQA'){
            steps{
                withSonarQubeEnv('sonar-server') {
                    sh "mvn clean verify sonar:sonar -Dsonar.projectKey=bee"
                }
            }
        }
        stage('Quality Gates'){
            steps{
                waitForQualityGate abortPipeline: true, credentialsId: 'stoken'
            }
        }
        stage('Nexus'){
            steps{
                script {
                    def groupId = sh(
                        script: "mvn help:evaluate -Dexpression=project.groupId -q -DforceStdout",
                        returnStdout: true
                    ).trim()
                
                    def artifactId = sh(
                        script: "mvn help:evaluate -Dexpression=project.artifactId -q -DforceStdout",
                        returnStdout: true
                    ).trim()
                
                    def version = sh(
                        script: "mvn help:evaluate -Dexpression=project.version -q -DforceStdout",
                        returnStdout: true
                    ).trim()
                
                    nexusArtifactUploader(
                        artifacts: [[
                            artifactId: artifactId,
                            classifier: '',
                            file: "target/${artifactId}-${version}.war",
                            type: 'war'
                        ]],
                        credentialsId: 'nexuspass',
                        groupId: groupId,
                        nexusUrl: '3.23.86.61:8081',
                        nexusVersion: 'nexus3',
                        protocol: 'http',
                        repository: 'apprepo',
                        version: version
                        //nexusArtifactUploader artifacts: [[artifactId: 'artifactId', classifier: '', file: 'target/${artifactId}-${version}.war', type: 'war']], credentialsId: 'nexuspass', groupId: 'groupId', nexusUrl: '3.23.86.61', nexusVersion: 'nexus3', protocol: 'http', repository: 'apprepo', version: 'version'
                    )
                }
            }
        }
        stage('Image Build'){
            steps{
                sh"cp -r target Docker-app"
                sh"docker build -t sriramk16/dockerwebapp:app Docker-app"
                sh"docker build -t sriramk16/dockerwebapp:db Docker-db"
            }
        }
        stage('Scan'){
            steps{
                sh"trivy image --severity CRITICAL --exit-code 0 sriramk16/dockerwebapp:app"
                sh"trivy image --severity CRITICAL --exit-code 0 sriramk16/dockerwebapp:db"
            }
        }
        stage("Registry"){
            steps{
                script{
                    withDockerRegistry(credentialsId: 'dockerhub') {
                    sh"docker push sriramk16/dockerwebapp:app"
                    sh"docker push sriramk16/dockerwebapp:db"
                    }
                }
            }
        }
        stage("update deployment"){
            steps{
                script{
                    withCredentials([usernamePassword(credentialsId: 'gitcred', passwordVariable: 'GIT_TOKEN', usernameVariable: 'GIT_USER')]) {
                    sh '''
                    sed -i 's|repository: .*| repository: sriramk16/dockerwebapp:app|' personahub/values.yaml
                    sed -i 's|repository1: .*| repository1: sriramk16/dockerwebapp:db|' personahub/values.yaml
                    
                    git config user.name Jenkins
                    git config user.email jenkins@bee.com
                    
                    git add personahub/values.yaml
                    git commit -m "updated values file"
                    //echo "$GIT_TOKEN"
                    //echo "$GIT_USER"
                    git remote set-url origin https://${GIT_USER}:${GIT_TOKEN}@github.com/${GIT_USER}/Docker-2-tier-app.git
                    git push origin main 
                    '''
                    }
                }
            }
        }
    }
}

